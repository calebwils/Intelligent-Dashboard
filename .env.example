# ==============================================================================
# AIFORCE AGENCY — MODÈLE DE CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier sous le nom '.env' et ajoutez votre clé secrète Qwen.
# Le fichier '.env' est automatiquement ignoré par Git via .gitignore.
# ==============================================================================

# Clé API Qwen / DashScope Alibaba Cloud (ex: sk-xxxxxxxxxxxxxxxxxxxxxxxx)
QWEN_API_KEY=votre_cle_api_secrete_ici

# Point de terminaison OpenAI-compatible
QWEN_BASE_URL=https://ws-hrpprn3nx2citb4c.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Modèle d'intelligence artificielle (recommandé: qwen-plus, qwen-turbo, qwen-max)
QWEN_MODEL=qwen-plus

# Port d'écoute du serveur de tableau de bord
PORT=8080

# Passerelle SMTP Gmail pour l'envoi d'analyses et de rapports par l'IA
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application_google
DEFAULT_RECIPIENT_EMAIL=destinataire@example.com
